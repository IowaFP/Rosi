-- Make sure explicit maps are allowed

-- I believe * is used rather than $, currently
current : forall f : * -> *, z : R[*]. Pi (f * z)
current = fix (\ x. x)

-- Without: 
without : forall f : * -> *, z : R[*]. Pi (f z)
without = fix (\ x. x)

-- With:
with: forall f : * -> *, z : R[*]. Pi (f $ z) 
with = fix (\ x. x)