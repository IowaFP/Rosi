import Ro.Base

type ROrdF : (R[*] -> R[*]) -> R[*] -> R[*]
type ROrdF rec z =
  { 'Empty := exists. z ~ {} => Unit
  , 'Single := exists l t. z ~ {l := t} => #l
  , 'Append := exists x y. x + y ~ z => (Sigma (rec x), Sigma (rec y))
  }

type ROrd : R[*] -> *
type ROrd z = Sigma (Mu ROrdF z)

