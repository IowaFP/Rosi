import Ro.Base, Ro.Xr, Data.Functor, Data.List, Data.Nat, Data.Tuple, EE.Types

-------------------------------------------------------------------------------
-- Desugaring
--
-- Next challenge is to implement desugaring. The key point here is to highlight
-- label-generic programming.
--
-- As an example, we'll implement Booleans as functions. We're relying on this
-- being an untyped language, so we don't have to account for polymorphism.

app : LamF < z => μ (Σ z) -> μ (Σ z) -> μ (Σ z)
app f e= 'App: (f, e)

desugarB : LamF < z => Xh BoolF (\w. μ (Σ z))
desugarB exp rec =
  match exp
  ('BConst: b ->
     if b ('Lam: ('Lam: ('Var: 1)))
   ('Lam: ('Lam: ('Var: 0)))
  | 'If: t -> app (app (rec t.'1) (rec t.'2)) (rec t.'3)
  )

-------------------------------------------------------------------------------
-- Identity traversal

ext : Π (Functor* z) ->
      Xh z (\w. (μ (Σ z)))
ext d v rec = fmapS d rec v

-------------------------------------------------------------------------------
-- Combined desugaring function

desugar : BoolF < y, LamF < y - BoolF =>
          Π (Functor (y - BoolF)) ->
          Xh y (\w. (μ (Σ (y - BoolF))))
desugar d = desugarB | ext d

-------------------------------------------------------------------------------
-- Examples

xpNot : μ (Σ (LamF + BoolF))
xpNot = 'Lam: ('If: ('Var: 0, 'BConst: False, 'BConst: True))

desNot : μ (Σ LamF)
desNot = histo (desugar functorLam) xpNot

xpArith : μ (Σ (ArithF + BoolF + LamF))
xpArith = 'Lam: ('If: ('Var: 0, 'IConst: 1, 'IConst: 2))

desArith : μ (Σ (ArithF + LamF))
desArith = histo (desugar (functorLam ++ functorArith)) xpArith

