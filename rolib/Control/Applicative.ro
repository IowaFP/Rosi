import Data.Functor, Data.Monoid

type Applicative : (* → *) → *
type Applicative f = Π { 'Functor := Functor f,
                         'pure    := ∀ a. a → f a,
                         'ap      := ∀ a b. f (a → b) → f a → f b }

applicativeFunctor : ∀ z : R[* → *]. Π (Applicative z) → Π (Functor z)
applicativeFunctor = mapP #Applicative #Functor (λl d. d.'Functor)

--------------------------------------------------------------------------------
-- The identity and constant functor

applicativeId : Applicative Id
applicativeId = ('Functor := λ @a @b. functorId,
                 'pure    := λ @a. id,
                 'ap      := λ @a @b f. f)
                 -- Explicit type abstractions still needed here..

-- as GHC defines it---Const m is applicative if m is a monoid.
applicativeConst : Monoid m → Applicative (Const m)
applicativeConst m = ('Functor := \@a @b. functorConst ,
                      'pure    := \@a. const m.'empty ,
                      'ap      := \@a @b. m.'append)

--------------------------------------------------------------------------------
-- The maybe functor

pureMaybe : a → Maybe a
pureMaybe = 'Just:

apMaybe : Maybe (a → b) → Maybe a → Maybe b
apMaybe = 'Just: g  → (λx. functorMaybe g x)
        | otherwise → const Nothing

applicativeMaybe : Applicative Maybe
applicativeMaybe = ('Functor := functorMaybe,
                    'pure    := pureMaybe,
                    'ap      := apMaybe)
