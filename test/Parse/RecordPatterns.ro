import Ro.Base, Data.Nat

-- single field
bar : Pi {'1 := Nat} -> (Nat -> a) -> a
bar ('1 := x) p = p (Succ x)


foo : Pair Nat Nat -> Nat
foo ('1 := x, '2 := y) = (add x y)


nested ('top := ('inner := ('innerInner := x)),
        'secondField := y) = tt

nested' = λ record.
                  let x = record.'top.'inner.'innerInner in
                    let y = record.'secondField in tt

lamDef = λ ('1 := x, '2 := y). x ^ y

nestedLam = λ ('1 := x, '2 := y). λ ('1 := z). x

-- Ensure that the order of binding means that x holds the correct "__RECORD.'1"
shouldBeYes = nestedLam ('1 := "YES", '2 := "y") ('1 := "NO")
