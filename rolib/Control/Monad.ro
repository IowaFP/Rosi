import Data.Functor, Control.Applicative, Data.List

type Monad : (* → *) → *
type Monad t = Π { 'Applicative := Applicative t,
                   'bind        := ∀ a b. t a → (a → t b) → t b }


composeKleisli : Monad t → (b → t c) → (a → t b) → (a → t c)
composeKleisli m f g a = m.'bind (g a) f

bindMaybe : Maybe a → (a → Maybe b) → Maybe b
bindMaybe = 'Nothing: u → (λk. Nothing)
          | 'Just: x    → (λk. k x)

monadMaybe : Monad Maybe
monadMaybe = ( 'Applicative := applicativeMaybe
             , 'bind        := bindMaybe )

composeMaybe : (b → Maybe c) → (a → Maybe b) → a → Maybe c
composeMaybe = composeKleisli monadMaybe
