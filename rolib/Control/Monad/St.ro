import Data.Functor, Data.Tuple, Control.Monad, Data.Traversable

type StM : * → * → *
type StM s v = s → Pair v s

functorStM : Functor (StM s)
functorStM f m s = first f (m s)

-- Want to fix the order of type arguments here so that we can partially apply
-- them implicitly later
pureStM : ∀ s a. a → StM s a
pureStM = pair

apStM : ∀ s a b. StM s (a → b) → StM s a → StM s b
apStM f m s = let x = f s in first (fst x) (m (snd x))

applicativeStM : Applicative (StM s)
applicativeStM = ( 'Functor := functorStM
                 , 'pure    := pureStM
                 , 'ap      := apStM )

bindStM : ∀ s a. StM s a → (a → StM s b) → StM s b
bindStM m k s = uncurry k (m s)

monadStM : Monad (StM s)
monadStM = ( 'Applicative := applicativeStM
           , 'bind        := bindStM )
