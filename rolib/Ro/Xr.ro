import Ro.Base, Data.Functor

-- For the moment, just (attempting to) transcribe the algebras from the draft
-- paper.

-------------------------------------------------------------------------------
-- Catamorphisms

type FAlg : (* → *) → * → *
type FAlg f a = f a → a

cata : Functor f → FAlg f a → μ f → a
cata map a = fix (λ cata x. a (map cata x))

rinj : f < g ⇒ Π (Functor f) → μ (Σ f) → μ (Σ g)
rinj d = cata (fmapS d) inj

rprj : f < g ⇒ Π (Functor g) → μ (Π g) → μ (Π f)
rprj d = cata (fmapP d) prj

-------------------------------------------------------------------------------
-- Mendler catamorphisms

type MAlg : (* → *) → * → *
type MAlg f c = ∀ a. (a → c) → f a → c

mcata : MAlg f a → μ f → a
mcata alg = fix (λmcata. alg mcata)

-------------------------------------------------------------------------------
-- Bounded algebras

type Xh : R[* → *] → (R[* → *] → *) → *
type Xh z f = ∀ w. z < w ⇒ Σ z (μ (Σ w)) → (μ (Σ w) → f w) → f w

type Xhs : R[* → *] → * → *
type Xhs z t = Xh z (λw. t)

histo : (f (μ f) → (μ f → r) → r) → μ f → r
histo a = fix (λ rec x. a x rec)

brna : x + y ~ z ⇒ Xh x f → Xh y f → Xh z f
brna f g = f | g

brnal : x < z ⇒ Xh x f → Xh z f → Xh z f
brnal f g = brnl f g