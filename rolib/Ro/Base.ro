-------------------------------------------------------------------------------
-- Functions

o : (u → v) → (t → u) → t → v
o f g x = f (g x)

type Id : * → *
type Id x = x

id : t → t
id x = x

type Const : * → * → *
type Const x y = x

const : t → u → t
const x y = x

flip : (a → b → c) → b → a → c
flip f b a = f a b

-------------------------------------------------------------------------------
-- Unit type

type Unit : *
type Unit = Π {}

tt : Unit
tt = prj ('x := \x. x)

-------------------------------------------------------------------------------
-- the any label

any : ∀ l : L. #l
any @l = #l

-------------------------------------------------------------------------------
-- Convenience functions for records and variants
--
-- Note: sel, con, match, case, and otherwise are used in desugaring! In
-- particular, this means they can't be implemented with sugar themselves!

-- sel : {l := t} < z ⇒ Pi z → #l → t
sel : Π> {l := t} → #l → t
sel r l = prj r :/ l

con : #l → t → Σ> {l := t}
con l x = inj (l := x)

match : a → (a → b) → b
match x f = f x

case : #l → (t → u) → Σ { l := t } → u
case l f x = f (x :/ l)

otherwise : a → b → a
otherwise = const

-------------------------------------------------------------------------------

brnl : x < z ⇒ (Σ x → t) → (Σ z → t) → Σ z → t
brnl f g = f | (g . inj)

relabelS : #l0 → #l1 → Σ ({l0 := t} + z) → Σ ({l1 := t} + z)
relabelS l0 l1 = case l0 (con l1) | inj

relabelP : #l0 → #l1 → Π ({l0 := t} + z) → Π ({l1 := t} + z)
relabelP l0 l1 r = (l1 := r.l0) ++ prj r

---

type Labels : R[*] → R[*]
type Labels r = Const Unit r

upd : Labels x' < Labels x ⇒ Π x → Π (x' + y) → Π (x + y)
upd r s = r ++ prj s

--------------------------------------------------------------------------------
-- Existential types

-- Function singleton here because figuring out functions is hard...
pack : ∀ f t. #f → f t → (∃ x. f x)
pack f x = x

--------------------------------------------------------------------------------
-- The Bool type

type Bool : *
type Bool = Σ { 'True 'False := Unit }

True : Bool
True = 'True: tt

False : Bool
False = 'False: tt

if : Bool → t → t → t
if = 'True: u → (\t1 t2. t1)
   | 'False: u → (\t1 t2. t2)

not : Bool → Bool
not b = if b False True

and : Bool → Bool → Bool
and b = if b id (const False)

or : Bool → Bool → Bool
or b = if b (const True) id

xor : Bool → Bool → Bool
xor b = if b not id

--------------------------------------------------------------------------------
-- Bot elimination

impossible : Σ {} → a
impossible = fix (\x. x)

-------------------------------------------------------------------------------
-- Basic analysis / synthesis


reflect : ∀ z : R[*], t. Π (z → t) → Σ z → t
reflect d w = ana #(λX. X) (λ l u. d.l u) w

-- Need to name type variables
reify : ∀ z t. (Σ z → t) → Π (z → t)
reify @z @t f = syn #(λX. X → t) (λl x. f (l: x))

-- Categorical duals to reify / reflect. Don't have great names for these.
decompose : ∀ z : R[*] , t. Π (t → z) → (t → Π z)
decompose d t = syn #(λ X. X) (λl. d.l t)

recompose : ∀ z : R[*] , t. (t → Π z) → Π (t → z)
recompose @z @t f = syn #(λ X. t → X) (λ l u. sel (f u) l)

every : a → Π ((Const a)* z)
every @a x = syn #(λX. a) (λl. x)

type Eq : * → *
type Eq t = t → t → Bool

eqS : ∀ z : R[*]. Π (Eq z) → Eq (Σ z)
eqS d v =  ana #(λX. X)
               (λ l y. match v
                       ( l: x → d.l x y
                       | otherwise → False))

eqP : Fold z ⇒ Π (Eq z) → Eq (Π z)
eqP d r = fold #(λt. t) (λl x. d.l r.l x) and True

-- Branching is derivable
branch : (Σ x → t) → (Σ y → t) → Σ (x + y) → t
branch f g = reflect (reify f ++ reify g)

-------------------------------------------------------------------------------

eqUnit : Eq Unit
eqUnit = eqP tt

eqBool : Eq Bool
eqBool = eqS (every eqUnit)

-------------------------------------------------------------------------------

type Maybe : * → *
type Maybe a = Σ { 'Nothing := Unit, 'Just := a }

Just : a → Maybe a
Just = 'Just:

Nothing : Maybe a
Nothing = 'Nothing: tt

maybe : b → (a → b) → Maybe a → b
maybe z f =
  ( 'Nothing: u → z
  | 'Just: x → f x
  )

is : {l := t} < z ⇒ #l → Σ z → Maybe t
is l = case l Just | otherwise Nothing

fromMaybe : a → Maybe a → a
fromMaybe z = maybe z id

maybeSigma : Σ (Maybe* z) → Maybe (Σ z)
maybeSigma = ana #Maybe (λk. maybe Nothing (Just . k:))

isJust : Maybe a → Bool
isJust = maybe False (const True)

isJusts : Fold z ⇒ Π (Maybe* z) → Bool
isJusts = fold #Maybe (const isJust) and True

fromJust : Maybe a → a
fromJust = fromMaybe (fix id)

maybePi : Fold z ⇒ Π (Maybe* z) → Maybe (Π z)
maybePi r = if (isJusts r)
               (Just (syn #Id (\k. fromJust r.k)))
               Nothing

-------------------------------------------------------------------------------

type Either : * → * → *
type Either a b = Σ { 'Left := a, 'Right := b }

Left : a → Either a b
Left = 'Left:

Right : b → Either a b
Right = 'Right:

either : (a → c) → (b → c) → Either a b → c
either f g = (case 'Left f | case 'Right g)

-------------------------------------------------------------------------------

sorry : ∀ a. a
sorry = fix (\x. x)
