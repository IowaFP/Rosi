import Ro.Base

-- [✓] Parse → as -> (in kind signatures)
import Parse.Unicode.ArrowKind

-- [✓] Parse → as -> (in type signatures)
import Parse.Unicode.ArrowType 

-- [✓] Parse ∖ as - 
import Parse.Unicode.Complement

-- [ ] Parse ∃ as "exists"
import Parse.Unicode.Exists 

-- [ ] Parse ∀ as "forall"
import Parse.Unicode.Forall 

-- [✓] Parse ▹ as ":=" in terms 
import Parse.Unicode.LabelsTerm

-- [✓] Parse ▹ as ":=" in types
import Parse.Unicode.LabelsType

-- [✓] Parse λ as \ 
import Parse.Unicode.LambdaTerm

-- [ ] Make sure explicit map ($) is permitted
import Parse.Unicode.Map 

-- [✓] Parse μ as "Mu"
import Parse.Unicode.Mu 

-- [✓] Parse Π as "Pi"
import Parse.Unicode.Pi

-- [✓] Parse Σ as "Sigma"
import Parse.Unicode.Sigma 

-- [✓] Parse Subscripts
import Parse.Unicode.Subscripts 

-- [✓] Parse ⇒ as => 
import Parse.Unicode.Then 

-- [✓] Parse * as ⋆
import Parse.Unicode.TypeKind

