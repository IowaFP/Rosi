import Ro.Base, Ro.Xr, Data.Functor, Data.Nat, Data.Tuple

type TreeF : * → * → *
type TreeF a = Σ { 'Empty := Const Unit, 'Node := λl. Triple l a l }

type Tree : * → *
type Tree a = Mu (TreeF a)

empty : Tree a
empty = 'Empty: tt

node : Tree a → a → Tree a → Tree a
node l a r = 'Node: (triple l a r)
