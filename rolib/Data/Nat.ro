import Ro.Base, Ro.Show, Data.Functor, Data.Tuple

type NatF : * → *
type NatF n = Σ { 'Zero := Unit, 'Succ := n}

fmapNatF : Functor NatF
fmapNatF = fmapS ('Zero := \@a @b (f : a → b) (u : Unit). u ,
                  'Succ := \@a @b (f : a → b). f)
                  -- These definitions still need to be explicitly polymorphic :(

type Nat : *
type Nat = μ NatF

Zero : Nat
Zero = 'Zero: tt

Succ : Nat → Nat
Succ = 'Succ:

--

decr : Nat → Nat
decr = 'Zero: u → Zero
     | 'Succ: n → n

add : Nat → Nat → Nat
add m=  fix (λadd . 'Zero: u → m
                  | 'Succ: nn → Succ (add nn))

mult : Nat → Nat → Nat
mult m = fix (λmult . 'Zero: u → Zero
                    | 'Succ: nn → add m (mult nn))

monus : Nat → Nat → Nat
monus = fix (λ monus m . 'Zero: u → m
                       | 'Succ: n' → monus (decr m) n')

max : Nat → Nat → Nat
max = fix (λmax m n.
  match m
  ( 'Zero: u  → n
  | 'Succ: m' →
    match n
    ( 'Zero: u  → m
    | 'Succ: n' → Succ (max m' n'))))

isZero : Nat → Bool
isZero = 'Zero: u  → True
       | otherwise → False

equal : Nat → Nat → Bool
equal = fix (λequal m n.
              match m
              ( 'Zero: u  → isZero n
              | 'Succ: mm →
                match n
                ( 'Zero: u  → False
                | 'Succ: nn → equal mm nn)))

lte : Nat → Nat → Bool
lte = fix (λlte m n.
            match m
            ( 'Zero: u  → True
            | 'Succ: m' →
              match n
              ( 'Zero: u  → False
              | 'Succ: n' → lte m' n')))

-- 3-way comparison

type Cmp : *
type Cmp = Σ {'GT 'LT 'EQ := Unit}

GT: Cmp
GT = 'GT: tt

LT: Cmp
LT = 'LT: tt

EQ: Cmp
EQ = 'EQ: tt

type Compare : * → *
type Compare a = a → a → Cmp

compN : Compare Nat
compN = fix (λcompN. 'Zero: u → ( 'Zero: u  → EQ
                                | 'Succ: b' → LT)
                   | 'Succ: a' → ( 'Zero: u  → GT
                                 | 'Succ: b' → compN a' b'))

-- division

divMod : Nat → Nat → Pair Nat Nat
divMod = fix (λdivMod n1 n2.
               match (compN n1 n2)
               ( 'EQ: u → (1, 0)
               | 'LT: u → (0, n1)
               | 'GT: u → if (equal (monus n1 n2) 0)
                             (0, n1)
                             (let p = divMod (monus n1 n2) n2 in
                                (add p.'1 1, p.'2))))

div : Nat → Nat → Nat
div n1 n2 = (divMod n1 n2).'1

mod : Nat → Nat → Nat
mod n1 n2 = (divMod n1 n2).'2

-- Show instance

-- helper for showNat. Should only be used when 0 <= n < 10
showNatDigit : Nat → String
showNatDigit =
  ( case 'Succ ( case 'Succ ( case 'Succ ( case 'Succ ( case 'Succ ( case 'Succ ( case 'Succ ( case 'Succ ( case 'Succ ( case 'Succ ( case 'Succ ( case 'Succ (const "[OOPS, digit > 9]")
                                                                                                                                                 | case 'Zero (const "10"))
                                                                                                                                    | case 'Zero (const "9"))
                                                                                                                       | case 'Zero (const "8"))
                                                                                                          | case 'Zero (const "8"))
                                                                                             | case 'Zero (const "7"))
                                                                                | case 'Zero (const "6"))
                                                                   | case 'Zero (const "5"))
                                                      | case 'Zero (const "4"))
                                         | case 'Zero (const "3"))
                            | case 'Zero (const "2"))
                | case 'Zero (const "1"))
  | case 'Zero (const "0"))

-- converts Nat to base 10 string.
showNat : Nat → String
showNat =
  fix (\showNat n.
          let divModResult = (divMod n 10) in (if (equal divModResult.'1 0) "" (showNat divModResult.'1)) ^ (showNatDigit divModResult.'2))




--

one : Nat
one = Succ Zero

two : Nat
two = Succ one

three : Nat
three = add one two

one0 : Nat
one0 = monus three two

three0 : Nat
three0 = max one0 three

three1 : Nat
three1 = max three one0

--

one' : Nat
one' = 1

three' : Nat
three' = add one' 2

three'1 : Nat
three'1 = max three' 1

--

one'' : String
one'' = showNat one'

three'' : String
three'' = showNat three'1