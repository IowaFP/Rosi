import Ro.Base, Data.List, Data.Nat

-- --------------------------------------------------------------------------------
-- Streams

type StreamF : * → R[ * → * ]
type StreamF a = {'hd := Const a , 'tl := λx. x }

type Stream : * → *
type Stream a = μ (Π (StreamF a))

-- Convert a sequence of nats into a Stream, starting at n
seq : (Nat → a) → Nat → Stream a
seq f = fix (λ seq n. ('hd := f n,
                       'tl := seq (Succ n)))

-- Return only the even elements of a stream
even : Stream a → Stream a
even = fix (\ even xs.
    ('hd := xs.'hd,
     'tl := even xs.'tl.'tl))

-- the odd
odd : Stream a → Stream a
odd xs = even xs.'tl

-- grab n elements from a stream
grab : Nat → Stream a → List a
grab = fix (λ grab n xs. match n
    ( 'Zero: u → nil
    | 'Succ: m → xs.'hd :: grab m xs.'tl))

-- example
firstTen : String
firstTen = showList showNat (grab 10 (even (seq id 0)))

-- --------------------------------------------------------------------------------
-- Or a rose by another other name

type RoseF : * → R[* → *]
type RoseF a = {'node := Const a, 'children := List }

type Rose : * → *
type Rose a = μ (Π (RoseF a))

prune : Nat → Rose a → Rose a
prune = fix (λ prune n t.
    ('node     := t.'node,
     'children := match n
        ( 'Zero: u → nil
        | 'Succ: m → map (prune m) t.'children)))

-- --------------------------------------------------------------------------------
-- Mendler-style coalgebras
-- For reference: https://arxiv.org/pdf/2005.00199

type MCoAlgebra : (* → *) → * → *
type MCoAlgebra f x = ∀ r : *. (x → r) → x → f r

coit : MCoAlgebra f x → x → Mu f
coit = fix (λ coit alg x. (alg (coit alg) x))

corec : (∀ r : *. (μ f → r) → (x → r) → x → f r) →
        x → μ f
corec = fix (λ corec alg x. (alg id (corec alg) x))

cov : (∀ r : *. (f r → r) → (x → r) → x → f r) →
      x → μ f
cov = fix (λ cov alg x. (alg id (cov alg) x))

-- --------------------------------------------------------------------------------
-- Programming with co-algebras

mapAlg : (a → b) → MCoAlgebra (Π (StreamF b)) (Stream a)
mapAlg f map xs = ('hd := f xs.'hd, 'tl := map xs.'tl)

streamMap : (a → b) → Stream a → Stream b
streamMap f = coit (mapAlg f)