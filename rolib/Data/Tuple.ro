import Ro.Base, Ro.Show

type Pair : * → * → *
type Pair t u = (t, u)

pair : t → u → (t, u)
pair x y = (x, y)

type Triple : * → * → * → *
type Triple t u v = (t, u, v)

triple : t → u → v → (t, u, v)
triple x y z = (x, y) ++ ('3 := z)

nth : #l → (a → b) → Π ({l := a} + y) → Π ({l := b} + y)
nth l f x = upd (l := f x.l) x

first  = nth '1
second = nth '2
third  = nth '3

curry : ((a, b) → c) → a → b → c
curry f x y = f (x, y)

uncurry : (a → b → c) → (a, b) → c
uncurry f p = f p.'1 p.'2

showPair : Show a → Show b → Show (a, b)
showPair showa showb p = "(" ^ (showa p.'1) ^ ", " ^ (showb p.'2) ^ ")"