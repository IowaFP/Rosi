import Data.Functor, Control.Applicative

type Traversable : (* → *) → *
type Traversable t = Π { 'Functor := Functor t,
                         'sequence := ∀ f a. Applicative f → t (f a) → f (t a) }

traversableFunctor : ∀ z : R[* → *]. Π (Traversable z) → Π (Functor z)
traversableFunctor = mapP #Traversable #Functor (λl d. d.'Functor)

sequenceS : ∀ z : R[* → *]. Π (Traversable z) → (∀ f a. Applicative f → Σ z (f a) → f (Σ z a))
sequenceS d @f @a applf v =
  ana #(λg. g (f a))
      (λl x. sel applf 'Functor (con l) (sel (sel d l) 'sequence applf x))
      v

traversableS : ∀ z : R[* → *]. Π (Traversable z) → Traversable (Σ z)
traversableS d = ('Functor  := fmapS (traversableFunctor d),
                  'sequence := sequenceS d)

-- Doing this for Pi requires (at least) some kind of fold, so passing for now...

sequenceMaybe : ∀ f a. Applicative f → Maybe (f a) → f (Maybe a)
sequenceMaybe a = 'Nothing: u -> a.'pure Nothing
                | 'Just: x    -> a.'Functor Just x

traversableMaybe : Traversable Maybe
traversableMaybe = ( 'Functor  := functorMaybe
                   , 'sequence := sequenceMaybe )
